[Unit]
Description=Unified GPU API (XTTS-v2 TTS) for radio DJ
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/marek/projects/rig-services
ExecStart=/home/marek/projects/rig-services/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --log-level info
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=ACESTEP_GENERATION_TIMEOUT=7200
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=default.target
